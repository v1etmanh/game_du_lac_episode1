# Copy this file to .env for local development (.env is git-ignored).
# On Vercel, set the same variables in Project → Settings → Environment Variables.

# --- AI interview (Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional: point the frontend to another deployed API endpoint.
# Leave empty/default when the site and api/ folder are deployed together.
VITE_INTERVIEW_API_URL=/api/interview-turn

# --- Behaviour tracking (Supabase → Project Settings → API) ---
# Without these, local dev stores events in .data/events.jsonl; on Vercel nothing is stored.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Feedback Google Sheet (must be viewable by anyone with the link) ---
FEEDBACK_SHEET_ID=10kfOze17QGdbVMlkLss7nTCKJsCXPTNX7-auCFvlGds
FEEDBACK_SHEET_GID=922517834
# Optional: a "Publish to web" CSV link; overrides the two values above.
FEEDBACK_CSV_URL=

# --- /admin login ---
ADMIN_USER=admin
ADMIN_PASS=change_me
# Any long random string; used to sign admin login tokens.
ADMIN_TOKEN_SECRET=change_me_to_a_long_random_string

# --- Player login with Google (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application") ---
# Authorized redirect URIs to add in Google Cloud:
#   http://localhost:5173/api/auth-callback
#   https://<your-domain>/api/auth-callback
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# Any long random string; used to sign the player login cookie.
AUTH_SECRET=change_me_to_another_long_random_string
# Optional: force the callback URL / site origin (otherwise derived from the request host).
GOOGLE_REDIRECT_URI=
PUBLIC_SITE_URL=
